VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_R2_WORKER_URL=https://resofly-media.YOUR_SUBDOMAIN.workers.dev
VITE_R2_PUBLIC_BASE_URL=

# Supabase Edge Function secrets for calendar integrations (set via `supabase secrets set`, not as Vite browser env)
# CALENDAR_REDIRECT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/calendar-integrations
# CALENDAR_ALLOWED_RETURN_ORIGINS=http://localhost:5173,https://staging.resofly.com,https://resofly.com,https://www.resofly.com,https://staging.resofly.pages.dev
# CALENDAR_OAUTH_STATE_SECRET=generate-a-long-random-string
# CALENDAR_TOKEN_ENCRYPTION_KEY=generate-a-long-random-string
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# MICROSOFT_CALENDAR_CLIENT_ID=...
# MICROSOFT_CALENDAR_CLIENT_SECRET=...
# MICROSOFT_CALENDAR_TENANT_ID=common

# Klant-billing — ResoFly-abonnementen op ResoFly's EIGEN Mollie-account
# Frontend gebruikt supabase.functions.invoke('billing'); secrets blijven server-side in Supabase Edge Function env.
# Model: ResoFly int de abonnementen op één eigen Mollie-account (Customers + mandaat
# via eerste betaling + Subscriptions). Begin met een test_-key; live = later live_-key.
MOLLIE_PLATFORM_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_URL=https://YOUR_PROJECT.functions.supabase.co/billing?webhook=mollie
MOLLIE_WEBHOOK_SECRET=generate-a-long-random-secret
# Sleutel waarmee de per-factuur Mollie-key van organisaties versleuteld wordt opgeslagen
# (gedeeld met invoice-workflow). Niet meer nodig voor de abonnementsflow zelf.
MOLLIE_TOKEN_ENCRYPTION_KEY=generate-a-long-random-token-encryption-key-min-32-chars
# Alleen lokaal/dev: laat checkouts zonder echte Mollie-call toe (mock). Nooit true in productie.
MOLLIE_ALLOW_MOCK=false
BILLING_ALLOWED_RETURN_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl

# LEGACY — oude "tenant koppelt eigen Mollie via OAuth Connect"-richting. Niet meer in
# gebruik voor de abonnementsflow; alleen behouden voor referentie/migratie.
# MOLLIE_CONNECT_CLIENT_ID=your_mollie_connect_client_id
# MOLLIE_CONNECT_CLIENT_SECRET=your_mollie_connect_client_secret
# MOLLIE_CONNECT_REDIRECT_URL=https://YOUR_PROJECT.functions.supabase.co/billing
# MOLLIE_OAUTH_STATE_SECRET=generate-another-long-random-secret-min-32-chars

# Quote approval + Resend flow (server-side Supabase Edge Function secrets)
# Deploy functions: quote-workflow, quote-public, resend-webhook
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=offertes@mail.jouwdomein.nl
RESEND_REPLY_TO=hello@jouwdomein.nl
# Regio waarin per-organisatie verzenddomeinen bij Resend worden aangemaakt
# (eigen-domein e-mail). Standaard eu-west-1 (Ierland) voor EU-dataresidentie.
RESEND_DEFAULT_REGION=eu-west-1
# Domein waarop antwoorden binnenkomen (fase C, Cloudflare Email Routing). Laat
# leeg tot het inbound-domein live staat; klant-mails krijgen dan een gewone
# Reply-To. Zodra gezet (bijv. inbound.resofly.nl) komen replies terug als
# reply+<id>@inbound... zodat fase C ze aan de klant kan koppelen.
MAIL_INBOUND_DOMAIN=
# Gedeeld secret tussen de Cloudflare Email Worker en de mail-inbound functie.
# Zelfde waarde zetten als Edge Function secret (supabase secrets set) én als
# Worker-secret (wrangler secret put MAIL_INBOUND_SECRET). Genereer iets willekeurigs.
MAIL_INBOUND_WEBHOOK_SECRET=
# Alleen lokaal/dev: laat mail-inbound zonder secret toe. Nooit true in productie.
MAIL_INBOUND_ALLOW_UNSIGNED=false
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_ALLOW_UNSIGNED=false
RESEND_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
QUOTE_PUBLIC_BASE_URL=https://app.jouwdomein.nl
QUOTE_TOKEN_TTL_DAYS=30
QUOTE_ALLOWED_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl
QUOTE_PUBLIC_ALLOWED_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl
QUOTE_ALLOW_LOCAL_DEV=false
MAIL_ALLOWED_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl
MAIL_ALLOW_LOCAL_DEV=false

# Invoice PDF snapshot storage (private R2 through Cloudflare Worker)
INVOICE_PDF_STORAGE_WORKER_URL=https://resofly-media.YOUR_SUBDOMAIN.workers.dev
INVOICE_PDF_STORAGE_SECRET=replace-with-long-random-shared-secret
# Cloudflare Worker secret with same value as INVOICE_PDF_STORAGE_SECRET
INTERNAL_UPLOAD_SECRET=replace-with-long-random-shared-secret

# Automatische betalingsherinneringen (invoice-workflow ?cron=reminders)
# Gedeeld secret waarmee de dagelijkse pg_cron-job (via pg_net) de herinneringsbatch
# triggert. Zet dezelfde waarde in de cron-aanroep (zie INVOICE_REMINDERS_SETUP_2026-06-16.md).
INVOICE_REMINDER_CRON_SECRET=replace-with-long-random-shared-secret
# Optioneel: max. aantal facturen dat één cron-run verwerkt (default 200).
INVOICE_REMINDER_BATCH_LIMIT=200

# Quote PDF snapshot storage (private R2 through Cloudflare Worker).
# Optional: when omitted, the quote-workflow function falls back to the
# INVOICE_PDF_STORAGE_* values above, so a single Worker + secret powers both.
# When neither is set, the sent PDF is stored as a base64 database fallback so
# downloads keep working in local/dev.
QUOTE_PDF_STORAGE_WORKER_URL=https://resofly-media.YOUR_SUBDOMAIN.workers.dev
QUOTE_PDF_STORAGE_SECRET=replace-with-long-random-shared-secret
# Max size for the quote PDF e-mail attachment / snapshot (bytes). Default 8 MB.
QUOTE_PDF_MAX_ATTACHMENT_BYTES=8388608

# Klantportaal (/portal) — server-side Supabase Edge Function secrets
# De `client-portal` function (verify_jwt = true) bedient het klantportaal. Klanten
# loggen wachtwoordloos in via een magische e-maillink en zien uitsluitend hun eigen
# facturen/offertes/tickets/projecten (toegang afgeleid uit het geverifieerde e-mailadres).
# CORS-allowlist voor de frontend-origin(s) die het portaal aanroepen; valt terug op
# APP_PUBLIC_URL en de invoice/quote-allowlists als deze leeg is.
CLIENT_PORTAL_ALLOWED_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl
# BELANGRIJK: voeg ${origin}/portal (bijv. http://localhost:5173/portal en je productie-URL)
# toe aan Supabase → Authentication → URL Configuration → Redirect URLs, anders werken
# de magische inloglinks van het portaal niet. De factuur-PDF-download in het portaal
# hergebruikt INVOICE_PDF_STORAGE_WORKER_URL/INVOICE_PDF_STORAGE_SECRET hierboven.
# Basis-URL van de frontend voor de portaallink in de welkomstmail (mail-function).
# Valt terug op APP_PUBLIC_URL/QUOTE_PUBLIC_BASE_URL/INVOICE_PUBLIC_BASE_URL en daarna
# op de request-origin. Zet 'm expliciet om te garanderen dat de link naar de juiste
# omgeving wijst (bijv. https://staging.jouwdomein.nl voor staging).
CLIENT_PORTAL_BASE_URL=https://app.jouwdomein.nl

# ── Meeting-opname + transcriptie + AI-notulen (Supabase Edge secrets) ─────────
# De `meeting-transcribe` function neemt de R2-audio op, stuurt die naar ElevenLabs
# Scribe en laat Claude (hergebruikt ANTHROPIC_API_KEY van Gerrie) de notulen maken.
#
# 1) ElevenLabs API-key (zet EU-dataresidentie + zero-retention aan in je ElevenLabs-account voor AVG).
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
# 2) Webhook-secret: zet WEBHOOK-modus aan (aanbevolen voor lange opnames). Configureer in het
#    ElevenLabs-dashboard een webhook naar:
#       https://<PROJECT>.supabase.co/functions/v1/meeting-transcribe-webhook
#    en zet hier hetzelfde secret. Laat leeg om synchroon te transcriberen (alleen korte opnames).
ELEVENLABS_WEBHOOK_SECRET=replace-with-elevenlabs-webhook-signing-secret
# 3) Optioneel: STT-model (default scribe_v1; zet op scribe_v2 zodra bevestigd), taal (default nl;
#    'auto' = autodetectie) en de prijs/uur voor de aparte transcriptie-kostenmeter (default 0.40).
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_LANGUAGE=nl
ELEVENLABS_USD_PER_HOUR=0.40
# 4) De edge-functie haalt de audiobytes server-side uit R2 via de media-worker. Zet dit op de
#    worker-URL (zelfde als VITE_R2_WORKER_URL). Voor het gedeelde secret valt de functie terug op
#    INVOICE_PDF_STORAGE_SECRET / QUOTE_PDF_STORAGE_SECRET als INTERNAL_UPLOAD_SECRET niet als
#    edge-secret bestaat (zelfde waarde als de worker-secret), dus meestal hoef je niets extra's te zetten.
MEDIA_WORKER_URL=https://resofly-media.YOUR_SUBDOMAIN.workers.dev
# 5) CORS-allowlist voor de frontend-origin(s); valt terug op GERRIE_ALLOWED_ORIGINS/APP_PUBLIC_URL.
MEETING_ALLOWED_ORIGINS=http://localhost:5173,https://app.jouwdomein.nl
MEETING_ALLOW_LOCAL_DEV=false
