{
  "id": "/app/documenten/",
  "name": "ResoFly Documenten",
  "short_name": "Documenten",
  "description": "Notities, documenten en bestanden van ResoFly, als eigen app.",
  "lang": "nl",
  "dir": "ltr",
  "start_url": "/app/documenten/",
  "scope": "/app/documenten/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E0E12",
  "theme_color": "#0E0E12",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "/icons/app-documenten-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-documenten-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-documenten-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/app-documenten-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
